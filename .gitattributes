# Git LFS Configuration
# Uncomment and use if you want to track large model files with Git LFS

# Track all model files (face-api.js models)
# public/models/*.bin filter=lfs diff=lfs merge=lfs -text
# public/models/*.weights filter=lfs diff=lfs merge=lfs -text
# public/models/*.json filter=lfs diff=lfs merge=lfs -text

# To enable Git LFS:
# 1. Install Git LFS: https://git-lfs.github.com/
# 2. Run: git lfs install
# 3. Uncomment the lines above
# 4. Run: git lfs track "public/models/*"
# 5. Commit and push
