# ============================================
# SmartTrack AI - Environment Configuration
# ============================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Security - JWT Configuration
# CRITICAL: Generate a strong random secret for production
# Example: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Face Recognition Configuration (Optional tuning)
FACE_RECOGNITION_THRESHOLD=0.6
FACE_DUPLICATE_THRESHOLD=0.62

# File Upload Configuration
MAX_UPLOAD_SIZE=5242880
ALLOWED_FILE_TYPES=jpeg,jpg,png,gif,webp

# Database Configuration
# Note: This app uses SQLite by default (file-based)
# For production, consider migrating to PostgreSQL/MySQL
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# CORS Configuration (if frontend is on different domain)
# CORS_ORIGIN=https://yourdomain.com

# Rate Limiting (requests per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# Logging Level (development|production)
LOG_LEVEL=info

# Session Configuration
SESSION_COOKIE_MAXAGE=86400000
